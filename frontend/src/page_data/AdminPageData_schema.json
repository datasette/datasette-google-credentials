{
  "$defs": {
    "AdminCredentialInfo": {
      "description": "One credential as a ``google-auth-admin`` sees it in the \"All\ncredentials\" view (ticket 15): ``CredentialInfo`` plus who owns it and\nwho used it last. Information only: it never grants use (D6).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "google_email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Google Email"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "status_detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status Detail"
        },
        "is_owner": {
          "title": "Is Owner",
          "type": "boolean"
        },
        "owner_id": {
          "title": "Owner Id",
          "type": "string"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Used At"
        },
        "last_used_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Used By"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "google_email",
        "scopes",
        "status",
        "status_detail",
        "is_owner",
        "owner_id",
        "created_by",
        "last_used_at",
        "last_used_by"
      ],
      "title": "AdminCredentialInfo",
      "type": "object"
    },
    "StatusResponse": {
      "description": "What the management page needs for its setup notices (ticket 14).",
      "properties": {
        "encryption_configured": {
          "title": "Encryption Configured",
          "type": "boolean"
        },
        "oauth_configured": {
          "title": "Oauth Configured",
          "type": "boolean"
        },
        "internal_db_persistent": {
          "title": "Internal Db Persistent",
          "type": "boolean"
        },
        "redirect_uri": {
          "title": "Redirect Uri",
          "type": "string"
        },
        "can_connect": {
          "title": "Can Connect",
          "type": "boolean"
        },
        "can_add_service_account": {
          "title": "Can Add Service Account",
          "type": "boolean"
        },
        "is_admin": {
          "title": "Is Admin",
          "type": "boolean"
        }
      },
      "required": [
        "encryption_configured",
        "oauth_configured",
        "internal_db_persistent",
        "redirect_uri",
        "can_connect",
        "can_add_service_account",
        "is_admin"
      ],
      "title": "StatusResponse",
      "type": "object"
    }
  },
  "description": "The ``/-/google-auth/admin`` \"All credentials\" page (ticket 15).\nInformation only: nothing here lets the admin use a credential (D6).",
  "properties": {
    "status": {
      "$ref": "#/$defs/StatusResponse"
    },
    "credentials": {
      "items": {
        "$ref": "#/$defs/AdminCredentialInfo"
      },
      "title": "Credentials",
      "type": "array"
    },
    "actor_names": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Actor Names",
      "type": "object"
    },
    "manage_url": {
      "title": "Manage Url",
      "type": "string"
    }
  },
  "required": ["status", "credentials", "actor_names", "manage_url"],
  "title": "AdminPageData",
  "type": "object"
}
